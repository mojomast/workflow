{
 "contract_version": "acdd/1",
 "id": "L4-ordering",
 "title": "acdd-lint: same-second phase ordering and stale RED",
 "outcome": {
  "summary": "check_history orders records by time, then protocol phase, then file name, and a RED recorded against another contract hash no longer satisfies RED-before-GREEN.",
  "observable_behavior": [
   "records with equal 'at' are ordered red, green, refactor, integration, review",
   "a stale RED is reported only as evidence_stale and never counts as the valid RED"
  ]
 },
 "interfaces": [
  {
   "name": "acdd_lint.evidence.check_history",
   "kind": "function",
   "change": "modify"
  }
 ],
 "acceptance_criteria": [
  {
   "id": "AC-001",
   "given": "red, green and refactor records with the same 'at' and file names that sort green first",
   "when": "check_history runs",
   "then": "no problems",
   "verification": "test",
   "tests": [
    "tools/acdd-lint/tests/test_ordering.py::OrderingTests::test_same_second_records_use_phase_order_not_file_name"
   ]
  },
  {
   "id": "AC-002",
   "given": "a RED recorded against an older contract hash",
   "when": "check_history runs",
   "then": "evidence_stale only; it does not satisfy RED-before-GREEN and is not also red_invalid",
   "verification": "test",
   "tests": [
    "tools/acdd-lint/tests/test_ordering.py::OrderingTests::test_stale_red_does_not_satisfy_red_before_green",
    "tools/acdd-lint/tests/test_ordering.py::OrderingTests::test_stale_failed_red_is_reported_once_as_stale"
   ]
  },
  {
   "id": "AC-003",
   "given": "the existing behaviour",
   "when": "the suite runs",
   "then": "time order still wins over phase order and every earlier acdd-lint test passes",
   "verification": "test",
   "tests": [
    "tools/acdd-lint/tests/test_ordering.py::OrderingTests::test_time_still_wins_over_phase",
    "tools/acdd-lint/tests/test_checks.py",
    "tools/acdd-lint/tests/test_cli.py",
    "tools/acdd-lint/tests/test_schema.py"
   ],
   "regression": true
  }
 ],
