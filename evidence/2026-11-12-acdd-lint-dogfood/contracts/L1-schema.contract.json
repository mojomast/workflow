   "docs/ACDD.md",
   "bundlebees_plugin/schemas/contract.schema.json",
   "bundlebees_plugin/schemas/evidence.schema.json"
  ],
  "prohibited": [
   ".github/*",
   "bundlebees_plugin/*",
   "tests/*",
   "plugin.yaml",
   "README.md",
   "CHANGELOG.md"
  ]
 },
 "source_rev": "bfd9f30237ac9b26d76c27b73dce6f2a3f5163c4",
