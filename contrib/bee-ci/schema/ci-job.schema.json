{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mojomast/workflow/contrib/bee-ci/schema/ci-job.schema.json",
  "title": "bee-run CI job manifest",
  "description": "One manifest per repository. Each entry declares a CI leg so a later dispatcher can choose bee-eligible Linux x64 work and leave GitHub-only legs alone.",
  "type": "object",
  "additionalProperties": false,
  "required": ["repo", "jobs"],
  "properties": {
    "repo": {
      "type": "string",
      "enum": ["workflow", "bundlebees", "orbitdesktop", "hyvv"]
    },
    "jobs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/job"}
    }
  },
  "$defs": {
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "os",
        "image",
        "arch",
        "python",
        "node",
        "browser",
        "runner"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "os": {
          "type": "string",
          "enum": ["ubuntu-24.04", "ubuntu-24.04-arm", "macos-14", "macos-15"]
        },
        "image": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "arch": {
          "type": "string",
          "enum": ["x64", "arm64"]
        },
        "python": {
          "type": ["string", "null"],
          "pattern": "^[0-9]+\\.[0-9]+$"
        },
        "node": {
          "type": ["string", "null"],
          "pattern": "^[0-9]+$"
        },
        "browser": {
          "type": "string",
          "enum": ["none", "chromium", "firefox", "webkit"]
        },
        "runner": {
          "type": "string",
          "enum": ["bee", "github-only"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"os": {"pattern": "^macos-"}},
            "required": ["os"]
          },
          "then": {
            "properties": {"runner": {"const": "github-only"}}
          }
        },
        {
          "if": {
            "properties": {"arch": {"const": "arm64"}},
            "required": ["arch"]
          },
          "then": {
            "properties": {"runner": {"const": "github-only"}}
          }
        }
      ]
    }
  }
}
