{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mojomast/workflow/schemas/acdd-contract.schema.json",
  "title": "ACDD work-item contract (acdd/1)",
  "description": "Agentic Contract-Driven Development contract for one independently reviewable work item. Portable across agent frameworks. JSON Schema covers shape; validators also apply the code checks listed in docs/16-acdd-tdd.md (unique AC ids, test ownership, frozen hash, human gates).",
  "type": "object",
  "required": ["contract_version", "id", "title", "outcome", "acceptance_criteria", "scope", "source_rev", "tdd", "verification", "evidence_required", "authorization"],
  "properties": {
    "contract_version": {"const": "acdd/1"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "title": {"type": "string", "minLength": 1},
    "outcome": {
      "type": "object",
      "required": ["summary", "observable_behavior"],
      "properties": {
        "summary": {"type": "string", "minLength": 1},
        "observable_behavior": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "interfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "kind", "change"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "kind": {"enum": ["function", "class", "module", "cli", "http", "schema", "file", "ui", "other"]},
          "change": {"enum": ["add", "modify", "remove", "none"]},
          "notes": {"type": "string"}
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "verification"],
        "properties": {
          "id": {"type": "string", "pattern": "^AC-[0-9]{3,}$"},
          "given": {"type": "string", "minLength": 1},
          "when": {"type": "string", "minLength": 1},
          "then": {"type": "string", "minLength": 1},
          "statement": {"type": "string", "minLength": 1},
          "verification": {"enum": ["test", "integration", "review", "manual"]},
          "tests": {"type": "array", "items": {"type": "string", "pattern": "^[^:\\s]+(::[^\\n]+)?$"}},
          "regression": {"type": "boolean", "description": "Existing behavior that must keep passing; its tests are expected to pass at baseline, so they are excluded from the RED set."}
        },
        "anyOf": [
          {"required": ["given", "when", "then"]},
          {"required": ["statement"]}
        ]
      }
    },
    "dependencies": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "assumptions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "scope": {
      "type": "object",
      "required": ["assigned_files"],
      "additionalProperties": false,
      "properties": {
        "assigned_files": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "test_files": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "read_only": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "prohibited": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "source_rev": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
    "tdd": {
      "type": "object",
      "required": ["applicable"],
      "properties": {
        "applicable": {"type": "boolean"},
        "reason": {"type": "string"},
        "test_first": {"type": "boolean", "description": "false records honestly that the tests were written after the implementation."}
      }
    },
    "verification": {
      "type": "object",
      "required": ["independent"],
      "properties": {
        "independent": {"const": true},
        "commands": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "integration": {"type": "boolean"}
      }
    },
    "evidence_required": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["red", "green", "refactor", "integration", "review", "security"]}
    },
    "authorization": {
      "type": "object",
      "required": ["human_gates"],
      "properties": {
        "human_gates": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["merge", "tag", "release", "deploy", "publish", "catalog", "post"]}},
        "authorized": {"type": "array", "items": {"type": "string"}},
        "not_authorized": {"type": "array", "items": {"type": "string"}}
      }
    },
    "review": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"enum": ["draft", "approved"]},
        "approved_by": {"type": "string", "minLength": 1},
        "approved_at": {"type": "string", "minLength": 1},
        "contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  },
  "additionalProperties": true
}
