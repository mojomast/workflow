{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mojomast/workflow/schemas/feature-packet.schema.json",
  "title": "Rizzstack feature packet (rizzstack.feature-packet/1)",
  "description": "One queued development feature, bound to an approved ACDD contract, a pinned workflow protocol revision, an authorization reference and a source-revision policy. The packet is not authorization: it records what was approved and lets any coordinator resume the work without the original chat.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "packet_version",
    "feature_id",
    "job_id",
    "request",
    "repository",
    "workflow_ref",
    "source_policy",
    "authorization",
    "acceptance_ids",
    "tests",
    "scope",
    "budget",
    "required_evidence",
    "prohibited",
    "human_gates"
  ],
  "properties": {
    "packet_version": {
      "const": "rizzstack.feature-packet/1"
    },
    "feature_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "job_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "request": {
      "type": "object",
      "required": [
        "summary",
        "provenance"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "type": "string",
          "minLength": 1,
          "description": "Where the request came from (card id, issue, message reference); not authority."
        }
      },
      "additionalProperties": false
    },
    "repository": {
      "type": "object",
      "required": [
        "identity"
      ],
      "properties": {
        "identity": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "branch": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "workflow_ref": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "Full commit SHA of the workflow protocol used to validate this packet."
    },
    "source_policy": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "revision"
          ],
          "properties": {
            "kind": {
              "const": "exact"
            },
            "revision": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "root_revision",
            "dependencies",
            "policy_id"
          ],
          "properties": {
            "kind": {
              "const": "descendant"
            },
            "root_revision": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "dependencies": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "policy_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "authorization": {
      "type": "object",
      "required": [
        "reference",
        "approved_by",
        "approved_at"
      ],
      "properties": {
        "reference": {
          "type": "string",
          "minLength": 1,
          "description": "Sealed M1 authorization (or enrolled policy) this packet depends on."
        },
        "approved_by": {
          "type": "string",
          "minLength": 1
        },
        "approved_at": {
          "type": "string",
          "minLength": 1
        },
        "limits": {
          "type": "object",
          "properties": {
            "bees": {
              "type": "integer",
              "minimum": 1
            },
            "wall_clock_s": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "contract": {
      "type": "object",
      "description": "The frozen acdd/1 contract."
    },
    "contract_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "acceptance_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^AC-[0-9]{3,}$"
      }
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "scope": {
      "type": "object",
      "required": [
        "lease",
        "read_only"
      ],
      "properties": {
        "lease": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "read_only": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "required": [
        "bees",
        "wall_clock_s"
      ],
      "properties": {
        "bees": {
          "type": "integer",
          "minimum": 1
        },
        "wall_clock_s": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "required_evidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "red",
          "green",
          "regression",
          "gitleaks",
          "integration"
        ]
      }
    },
    "prohibited": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "human_gates": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "merge",
          "release",
          "deploy",
          "publish"
        ]
      }
    },
    "handoff_ref": {
      "type": "string"
    },
    "return_ref": {
      "type": "string"
    },
    "contract_template": {
      "type": "object",
      "description": "Unfrozen acdd/1 contract template for a dependent feature; the source-bound contract is created by the source-resolution record."
    },
    "source_resolution_ref": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "source_policy": {
            "properties": {
              "kind": {
                "const": "exact"
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "contract",
          "contract_sha256"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "source_policy": {
            "properties": {
              "kind": {
                "const": "descendant"
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "contract_template"
        ]
      }
    }
  ]
}
