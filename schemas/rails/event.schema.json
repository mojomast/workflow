{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mojomast/workflow/schemas/rails/event.schema.json",
  "title": "Rizzstack Rails event — R01 freeze candidate",
  "$comment": "R01 freeze candidate for the rizzstack.rails/1 envelope. Kind payloads are closed by payload.schema.json (rizzstack.rails-payload/1), the source adapter wire objects by source.schema.json, query/result by query.schema.json, the presentation projection by view.schema.json, the HTTP surface by http.schema.json and the RETURN companion by evidence.schema.json; hash vectors live in fixtures/hash-vectors.json and the recorded freeze digest in README.md. A consumer that does not recognize a version refuses it; no silent widening of /1. Schema validation alone does not establish privacy, authorization, identity, chaining or source completeness.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "chain_id",
    "seq",
    "event_id",
    "dedupe_key",
    "source",
    "scope",
    "lane_id",
    "parent_lane_id",
    "parent_event_id",
    "kind",
    "occurred_at",
    "recorded_at",
    "duration_ms",
    "timing_quality",
    "authority",
    "payload",
    "redaction_policy",
    "prev_hash",
    "hash"
  ],
  "properties": {
    "schema": {
      "const": "rizzstack.rails/1"
    },
    "chain_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
    },
    "seq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "event_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
    },
    "dedupe_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter",
        "instance",
        "record_id",
        "revision"
      ],
      "properties": {
        "adapter": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
        },
        "instance": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
        },
        "record_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo",
        "campaign_id",
        "job_id",
        "task_id",
        "attempt_id",
        "session_id",
        "action_id",
        "contract_sha256",
        "code_rev"
      ],
      "properties": {
        "repo": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "campaign_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "job_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "task_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "attempt_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "session_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "action_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "contract_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "code_rev": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "anyOf": [
        {
          "properties": {
            "campaign_id": {
              "type": "string"
            }
          },
          "required": [
            "campaign_id"
          ]
        },
        {
          "properties": {
            "job_id": {
              "type": "string"
            }
          },
          "required": [
            "job_id"
          ]
        },
        {
          "properties": {
            "task_id": {
              "type": "string"
            }
          },
          "required": [
            "task_id"
          ]
        },
        {
          "properties": {
            "attempt_id": {
              "type": "string"
            }
          },
          "required": [
            "attempt_id"
          ]
        },
        {
          "properties": {
            "session_id": {
              "type": "string"
            }
          },
          "required": [
            "session_id"
          ]
        },
        {
          "properties": {
            "action_id": {
              "type": "string"
            }
          },
          "required": [
            "action_id"
          ]
        }
      ]
    },
    "lane_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
    },
    "parent_lane_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "parent_event_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "kind": {
      "enum": [
        "lane.open",
        "lane.spawn",
        "lane.close",
        "tool.start",
        "tool.finish",
        "decision.recorded",
        "attempt.state",
        "job.state",
        "queue.transition",
        "lease.recorded",
        "verification.result",
        "review.result",
        "integration.result",
        "merge.result",
        "acceptance.result",
        "usage.observed",
        "feedback.recorded",
        "intervention.requested",
        "intervention.result",
        "history.superseded",
        "source.gap",
        "source.checkpoint",
        "source.error"
      ]
    },
    "occurred_at": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
        },
        {
          "type": "null"
        }
      ]
    },
    "recorded_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "duration_ms": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "timing_quality": {
      "enum": [
        "measured",
        "estimated",
        "unknown"
      ]
    },
    "authority": {
      "enum": [
        "worker_report",
        "coordinator_record",
        "verifier_record",
        "reviewer_record",
        "owner_record",
        "imported_observation"
      ]
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "call_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
        },
        "tool_name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
        },
        "command_family": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 80
            },
            {
              "type": "null"
            }
          ]
        },
        "outcome": {
          "enum": [
            "pending",
            "ok",
            "failed",
            "cancelled",
            "unknown"
          ]
        },
        "summary": {
          "type": "string",
          "maxLength": 1000
        },
        "evidence_ref": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "ac_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
        },
        "contract_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "code_rev": {
          "type": "string",
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
        },
        "phase": {
          "enum": [
            "red",
            "green",
            "refactor",
            "integration"
          ]
        },
        "verdict": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_RUN",
            "BLOCKED",
            "UNVERIFIED",
            "EXPECTED_RED"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
          }
        },
        "reason": {
          "type": "string",
          "maxLength": 1000
        },
        "review_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
        },
        "reviewer": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
        },
        "author": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
        },
        "reviewed_head": {
          "type": "string",
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "review_verdict": {
          "enum": [
            "approve",
            "approve_with_followups",
            "changes_requested",
            "not_run"
          ]
        },
        "independent": {
          "type": "boolean"
        },
        "basis": {
          "type": "string",
          "maxLength": 200
        },
        "from_state": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "to_state": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
        },
        "operation_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
        },
        "fencing_epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "code": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
        },
        "lease_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "file_count": {
          "type": "integer",
          "minimum": 0
        },
        "usage_record_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
        },
        "metric_scope": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
        },
        "input_tokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "output_tokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "thinking_tokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "usage_basis": {
          "enum": [
            "delta",
            "cumulative",
            "final"
          ]
        },
        "provider": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "model": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "target_event_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
        },
        "rating": {
          "enum": [
            -1,
            0,
            1,
            null
          ]
        },
        "note": {
          "type": "string",
          "maxLength": 2000
        },
        "category": {
          "enum": [
            "quality",
            "intervention",
            "both"
          ]
        },
        "actor": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
        },
        "supersedes_event_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "request_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
        },
        "operation": {
          "enum": [
            "retry",
            "rewind_retry"
          ]
        },
        "queue_action_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "decision": {
          "enum": [
            "pending",
            "approved",
            "declined",
            "blocked",
            "completed",
            "failed"
          ]
        },
        "authority_ref": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "old_event_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
          }
        },
        "replacement_event_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "replacement_lane_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
        },
        "cursor": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1024
            },
            {
              "type": "null"
            }
          ]
        },
        "range_start": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "range_end": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "child_lane_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
        },
        "status": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
        },
        "expected_intent_ref": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
        }
      }
    },
    "redaction_policy": {
      "const": "rails-safe/1"
    },
    "prev_hash": {
      "anyOf": [
        {
          "const": "genesis"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      ]
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "tool.start",
              "tool.finish"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "call_id",
              "tool_name",
              "command_family",
              "outcome",
              "summary",
              "evidence_ref"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "verification.result",
              "acceptance.result"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "ac_id",
              "contract_sha256",
              "code_rev",
              "run_id",
              "phase",
              "verdict",
              "evidence_refs",
              "reason"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "payload": {
            "properties": {
              "verdict": {
                "const": "PASS"
              }
            },
            "required": [
              "verdict"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "properties": {
              "evidence_refs": {
                "minItems": 1
              }
            },
            "required": [
              "evidence_refs"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "payload": {
            "properties": {
              "verdict": {
                "enum": [
                  "FAIL",
                  "NOT_RUN",
                  "BLOCKED",
                  "UNVERIFIED",
                  "EXPECTED_RED"
                ]
              }
            },
            "required": [
              "verdict"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "properties": {
              "reason": {
                "minLength": 1
              }
            },
            "required": [
              "reason"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "feedback.recorded"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "target_event_id",
              "rating",
              "note",
              "category",
              "actor",
              "supersedes_event_id"
            ]
          }
        }
      }
    }
  ]
}

