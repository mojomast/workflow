{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mojomast/workflow/schemas/rails/source.schema.json",
  "title": "Rizzstack Rails source adapter contract \u2014 rizzstack.rails-source/1",
  "$comment": "R01 freeze candidate. This file bundles the wire objects of the source adapter interface (spec section 5). Validate an instance against the anyOf branch whose properties.schema const matches the instance's schema tag; the root object is a document, not an instance schema. read_batch never updates the source or the ledger: the importer commits records and acknowledges its cursor in one transaction. Malformed complete rows produce a source.error event with an opaque record identifier and digest, never raw text.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema"
  ],
  "properties": {
    "schema": {
      "const": "rizzstack.rails-source/1"
    }
  },
  "caps": {
    "max_limit": 500,
    "batch_max_bytes": 1048576,
    "record_max_bytes": 65536,
    "cursor_max_bytes": 1024,
    "$comment": "Default caps from spec section 5: limit <= 500; batch <= 1 MiB; record <= 64 KiB. Adjustment needs a recorded rationale and updated fixtures (spec D6)."
  },
    "anyOf": [
        {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "schema"
            ],
            "properties": {
                "schema": {
                    "const": "rizzstack.rails-source/1"
                }
            }
        },
