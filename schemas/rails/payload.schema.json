{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mojomast/workflow/schemas/rails/payload.schema.json",
  "title": "Rizzstack Rails closed kind payload schemas \u2014 rizzstack.rails-payload/1",
  "$comment": "R01 freeze candidate. One closed schema per core kind listed in event.schema.json. Additional properties are refused; a consumer that does not recognize a version refuses it. Producers must scrub and allowlist payload values before canonical storage (privacy invariant R-PRIV); these schemas constrain shape only and cannot establish secret absence, producer authority or evidence truth.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "kinds"
  ],
  "properties": {
    "schema": {
      "const": "rizzstack.rails-payload/1"
    },
    "kinds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lane.open",
        "lane.spawn",
        "lane.close",
        "tool.start",
        "tool.finish",
        "decision.recorded",
        "attempt.state",
        "job.state",
        "queue.transition",
        "lease.recorded",
        "verification.result",
        "review.result",
        "integration.result",
        "merge.result",
        "acceptance.result",
        "usage.observed",
        "feedback.recorded",
        "intervention.requested",
        "intervention.result",
        "history.superseded",
        "source.gap",
        "source.checkpoint",
        "source.error"
      ],
      "properties": {
        "lane.open": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
            }
          },
          "$comment": "Minimal provisional shape; lane identity lives in the envelope lane_id/parent_lane_id."
        },
        "lane.spawn": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "child_lane_id"
          ],
          "properties": {
            "child_lane_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
            }
          },
          "$comment": "Explicit spawn link; the child lane is recorded here and in the envelope parent fields."
        },
        "lane.close": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
            }
          },
          "$comment": "Minimal provisional shape; closure reason may be added by a versioned /2, not by silent widening."
        },
        "tool.start": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "call_id",
            "tool_name",
            "command_family",
            "outcome",
            "summary",
            "evidence_ref"
          ],
          "properties": {
            "call_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
            },
            "tool_name": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
            },
            "command_family": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 80
                },
                {
                  "type": "null"
                }
              ]
            },
            "outcome": {
              "const": "pending"
            },
            "summary": {
              "type": "string",
              "maxLength": 1000
            },
            "evidence_ref": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "$comment": "A start has not concluded; its outcome is pending. Pairing is by same origin/lane/call_id only."
        },
        "tool.finish": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "call_id",
            "tool_name",
            "command_family",
            "outcome",
            "summary",
            "evidence_ref"
          ],
          "properties": {
            "call_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
            },
            "tool_name": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
            },
            "command_family": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 80
                },
                {
                  "type": "null"
                }
              ]
            },
            "outcome": {
              "enum": [
                "pending",
                "ok",
                "failed",
                "cancelled",
                "unknown"
              ]
            },
            "summary": {
              "type": "string",
              "maxLength": 1000
            },
            "evidence_ref": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "outcome": {
                    "const": "pending"
                  }
                },
                "required": [
                  "outcome"
                ]
              },
              "then": false
            }
          ],
          "$comment": "A finish always concludes; pending is not a finish outcome. Interrupted calls stay open without a finish or carry outcome unknown/cancelled on a real finish."
        },
