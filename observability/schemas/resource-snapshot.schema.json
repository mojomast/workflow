{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mojomast/workflow/observability/schemas/resource-snapshot.schema.json",
  "title": "Resource snapshot (resource.snapshot/v1)",
  "description": "Periodic snapshot of credits, allowances, compute units, in-flight bees, and host capacity. A missing or unreadable value uses status 'unavailable' and a null value or remaining; never encode unknown as 0. Credentials used to fetch balances must not appear in this record or in logs. Two OpenCode Go keys are two rows with distinct non-secret labels in resource_id.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "ts",
    "source",
    "resources"
  ],
  "properties": {
    "schema": {
      "const": "resource.snapshot/v1"
    },
    "schema_version": {
      "const": "v1"
    },
    "attempt_id": {
      "$ref": "common.schema.json#/$defs/nullable_id"
    },
    "card_id": {
      "$ref": "common.schema.json#/$defs/nullable_id"
    },
    "run_id": {
      "$ref": "common.schema.json#/$defs/nullable_id"
    },
    "project": {
      "$ref": "common.schema.json#/$defs/nullable_id"
    },
    "role": {
      "$ref": "common.schema.json#/$defs/nullable_role"
    },
    "ts": {
      "$ref": "common.schema.json#/$defs/utc_timestamp"
    },
    "source": {
      "$ref": "common.schema.json#/$defs/id_token"
    },
    "bee_cap": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "description": "Shared bee cap when known. The current operational cap is 12, shared across coordinators. Do not invent a value."
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/resource_row"
      }
    }
  },
  "$defs": {
    "resource_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "status"
      ],
      "properties": {
        "kind": {
          "enum": [
            "deepseek_credit",
            "go_allowance",
            "google_colab_cu",
            "grok_bot_usage",
            "bees_in_flight",
            "cursor_cloud_agents",
            "hermes_host",
            "box_disk",
            "box_cpu",
            "box_ram",
            "pc_disk",
            "pc_cpu",
            "pc_ram"
          ]
        },
        "resource_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
          "description": "Local label that distinguishes peers of the same kind, such as two OpenCode Go keys. Never key material, a secret, or a hostname."
        },
        "value": {
          "type": [
            "number",
            "null"
          ],
          "description": "Observed value. Null when status is unavailable. Zero is allowed only when the value is genuinely zero."
        },
        "unit": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "usd",
            "percent",
            "count",
            "compute_unit",
            "byte",
            "ratio"
          ]
        },
        "cap": {
          "type": [
            "number",
            "null"
          ]
        },
        "remaining": {
          "type": [
            "number",
            "null"
          ]
        },
        "reset_at": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "common.schema.json#/$defs/utc_timestamp"
            }
          ]
        },
        "status": {
          "enum": [
            "ok",
            "low",
            "exhausted",
            "unavailable"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "unavailable"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              },
              "remaining": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
